# ==========================
# CPU profile (recommended)
# ==========================
# Container runtime. Use runc for CPU mode.
DOCKER_RUNTIME=runc # runc or nvidia for GPU
# Inference device: cpu, cuda, or auto.
DEVICE=cpu
# CUDA GPU index (used only when DEVICE=cuda).
GPU_ID=0
# Enable FP16 inference (effective only on CUDA).
HALF_PRECISION=false

# Host has 16 logical processors, 8 physical cores.
# Start with these values, then fine-tune.
# PyTorch intra-op threads. 16 matches logical processors.
CPU_THREADS=16
# PyTorch inter-op threads. Small value helps scheduler efficiency.
CPU_INTEROP_THREADS=2
# OpenCV worker threads. 8 matches physical cores.
CV_THREADS=8

# Tiling can reduce memory usage; for CPU start from 0 (full image)
# and try 200-400 for very large images if memory is tight.
# Default tile size for inference. 0 means process full image in one pass.
DEFAULT_TILE=0
# Extra overlap between tiles to reduce boundary seams.
TILE_PAD=10
# Padding around image edges before inference to reduce edge artifacts.
PRE_PAD=0

# JPEG output quality (1-100). Higher is better quality and larger file.
JPEG_QUALITY=95
# WebP output quality (1-100). Higher is better quality and larger file.
WEBP_QUALITY=95
# Model weights filename from the model/ directory.
MODEL=RealESRGAN_x4plus.pth

# ==========================
# GPU profile (optional)
# ==========================
# If Docker + NVIDIA runtime is configured, switch to:
# NVIDIA runtime required for GPU container access.
# DOCKER_RUNTIME=nvidia
# Force CUDA inference device.
# DEVICE=cuda
# Select target GPU index.
# GPU_ID=0
# Enable half precision for better GPU throughput.
# HALF_PRECISION=true
# Keep 0 to let framework auto-tune CPU helper threads.
# CPU_THREADS=0
# Keep 0 to let framework auto-tune inter-op threads.
# CPU_INTEROP_THREADS=0
# Keep 0 to let OpenCV auto-select thread count.
# CV_THREADS=0
